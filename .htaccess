<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>
    Options +FollowSymLinks

    RewriteEngine On

    # ป้องกันการเข้าถึงไฟล์ .env, .git และไฟล์ระบบที่ขึ้นต้นด้วยจุด
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # ป้องกันการเข้าถึง .env และ config สำคัญ
    <FilesMatch "(\.env|\.env\.production|\.env\.example|composer\.(json|lock)|package\.(json|lock)|artisan|\.sqlite|\.sql|\.log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # ป้องกันการเข้าถึงโฟลเดอร์สำคัญโดยตรง
    RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage/logs|tests)/

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ส่งทุกคำขอไปยังโฟลเดอร์ public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
